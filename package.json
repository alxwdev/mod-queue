{
  "name": "modqueue",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:api": "pnpm --filter @modqueue/api dev",
    "build": "pnpm --filter @modqueue/web build",
    "start": "pnpm --filter @modqueue/web start",
    "generate": "pnpm --filter @modqueue/api prisma:generate",
    "postinstall": "pnpm generate",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "pnpm --filter @modqueue/web test:e2e",
    "screenshots": "pnpm --filter @modqueue/web screenshots",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @modqueue/api db:migrate",
    "db:seed": "pnpm --filter @modqueue/api db:seed",
    "db:reset": "pnpm --filter @modqueue/api db:reset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.3",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
