# Copy to .env and fill in the values. Never commit .env files.

# Runtime connection (Neon pooled URL in Vercel).
DATABASE_URL=postgresql://modqueue:modqueue@localhost:5432/modqueue
# Migrations through prisma.config.ts (Neon direct URL in Vercel; locally the same as DATABASE_URL).
DATABASE_URL_UNPOOLED=postgresql://modqueue:modqueue@localhost:5432/modqueue
# API integration tests (local and CI).
DATABASE_URL_TEST=postgresql://modqueue:modqueue@localhost:5432/modqueue_test

# Protects /api/cron/reset-demo. Vercel only: 32+ random characters.
CRON_SECRET=
# Enables /api/test/reset. Set to 1 only for local E2E runs and CI, never in Vercel.
E2E_TEST_ROUTES=

# development | preview | production. Sentry environment and dev-only pages.
NEXT_PUBLIC_APP_ENV=development

# Sentry error reporting (Vercel).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Sentry source map upload (Vercel build only).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
